<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- Simulator-only identity for local Keychain tests; never used for device signing. -->
<key>application-identifier</key><string>sk.palkoskoda.xr18panel</string>
<key>keychain-access-groups</key><array><string>sk.palkoskoda.xr18panel</string></array>
<key>get-task-allow</key><true/>
</dict></plist>
